{
  "seed": 42,

  "dataset": {
    "name": "mnist",
    "data_dir": "data/MNIST/raw",
    "range": [-1.0, 1.0]
  },

  "model": {
    "name": "gan",
    "latent_dim": 100,
    "g_hidden_dims": [256, 512, 1024],
    "d_hidden_dims": [512, 256]
  },

  "optimizer": {
    "name": "adam",
    "lr": 0.0002,
    "beta1": 0.5,
    "beta2": 0.999,
    "eps": 1e-8
  },

  "training": {
    "enabled": true,
    "epochs": 50,
    "batch_size": 128
  },

  "sampling": {
    "num_samples": 64,
    "sample_dir": "samples/gan_mnist"
  },

  "checkpoint": {
    "checkpoint_dir": "checkpoints/gan_mnist",
    "load_checkpoint": false,
    "load_checkpoint_path": "checkpoints/gan_mnist/epoch_1.safetensors"
  }
}
